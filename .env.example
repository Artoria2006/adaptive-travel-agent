# Copy to .env, then launch with python run.py.
TRAVEL_ONLINE=1
TRAVEL_DEMO=0
# Opt-in endpoint of a self-hosted or authorized Overpass instance.
TRAVEL_OVERPASS_URL=
# Comma-separated expert IDs to disable for the capability gap demo.
TRAVEL_DISABLED=
# OpenAI-compatible base URL ending in /v1, model, and API key. All are required.
TRAVEL_LLM_URL=
TRAVEL_LLM_MODEL=
TRAVEL_LLM_KEY=
